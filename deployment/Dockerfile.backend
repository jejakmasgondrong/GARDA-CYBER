FROM python:3.12-slim

WORKDIR /app

COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY backend/ .

# SQLite harus berada di volume PERSISTEN, bukan filesystem sementara container,
# agar data tidak hilang saat container dibuat ulang. Lihat docker-compose.yml.
EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
