# Salin file ini menjadi .env lalu isi sesuai lingkungan Anda.
# JANGAN commit file .env ke Git.

APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DATABASE_URL=sqlite:///./garda_cyber.db
FRONTEND_ORIGIN=http://localhost:5173

# Wajib diisi sebelum production.
SECRET_KEY=

# Diisi sendiri saat tahap deployment VPS (tidak dipakai untuk development lokal).
DOMAIN_NAME=

# --- Integrasi Tahap 2 (opsional, status "not_configured" sampai diisi) ---
NMAP_BINARY=
OWASP_ZAP_URL=
OWASP_ZAP_API_KEY=
WAZUH_API_URL=
WAZUH_API_USER=
WAZUH_API_PASSWORD=

# --- IP Intelligence: AbuseIPDB API v2 ---
# Daftar gratis di https://www.abuseipdb.com/ untuk mendapatkan API key.
# Jika diisi, provider AbuseIPDB aktif otomatis. Kosongkan untuk fallback ke demo.
ABUSEIPDB_API_KEY=

# --- IP Intelligence: provider demo (SELALU diberi label DEMO, bukan reputasi nyata) ---
# Set ke "true" untuk mengaktifkan provider contoh. Kosongkan untuk tetap not_configured.
DEMO_PROVIDER_ENABLED=

# --- OSINT Domain Intelligence: SUDAH diimplementasikan (lihat app/services/osint_*.py) ---
# Tidak butuh API key -- cukup dikosongkan untuk memakai nilai default di bawah.
OSINT_DNS_TIMEOUT_SECONDS=4.0
OSINT_TLS_TIMEOUT_SECONDS=4.0
OSINT_MAX_TXT_RECORDS=20

# --- GitHub Exposure Monitor: SUDAH diimplementasikan ---
# Jangan pernah commit token asli ke Git. Buat Personal Access Token (fine-grained,
# scope read-only "Contents") khusus untuk ini di github.com/settings/tokens.
GITHUB_TOKEN=
# Daftar "owner/repo" dipisah koma -- HANYA repo di sini yang boleh di-scan,
# walau token punya akses lebih luas. Kosongkan untuk menonaktifkan fitur ini.
GITHUB_EXPOSURE_ALLOWED_REPOS=
GITHUB_MAX_FILES_PER_SCAN=200
GITHUB_MAX_FILE_BYTES=200000
GITHUB_API_TIMEOUT_SECONDS=10.0
